# ==============================================================================
# Environment Configuration Template for Mohd. Amin Auto Parts (MAAPS) Catalog
# Copy this file to .env to configure your local development environment:
#   cp .env.example .env
# ==============================================================================

# Server & Development Port
PORT=3000
VITE_PORT=3000
NODE_ENV=development

# Host & Networking
HOST=0.0.0.0

# Base Application URL
# Used for self-referential links, API endpoints, and share URLs
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

# Vite Hot Module Replacement (HMR)
# Set to 'false' for local development on PC so live reloading works smoothly.
# AI Studio sets DISABLE_HMR=true in cloud preview environments.
DISABLE_HMR=false

# Google Gemini API Key
# Optional: Required if using Gemini AI API features.
# In AI Studio, this is automatically injected at runtime.
# On a local PC, get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application Branding & Metadata
VITE_APP_NAME="Mohd. Amin Auto Parts"
VITE_APP_DESCRIPTION="Automotive Spare Parts View-Only Catalog & OE Part Search"

